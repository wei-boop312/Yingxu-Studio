{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateGenerationTaskV4",
  "description": "文档阶段的严格请求契约。跨字段尺寸、产品/用户归属、quote消费和矩形重叠仍需服务端及数据库验证。",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_id", "source_asset_version_id", "generation", "targets", "quote_id"],
  "properties": {
    "product_id": {"type":"string","format":"uuid"},
    "appearance_profile_id": {"type":["string","null"],"format":"uuid"},
    "source_asset_version_id": {"type":"string","format":"uuid"},
    "quote_id": {"type":"string","format":"uuid"},
    "generation": {
      "type":"object","additionalProperties":false,
      "required":["type","prompt","output","protection_mode","regions"],
      "properties": {
        "type":{"enum":["white_background","scene","lifestyle"]},
        "prompt":{"type":"string","minLength":1,"maxLength":4000},
        "output":{
          "type":"object","additionalProperties":false,"required":["width","height","format"],
          "properties":{
            "width":{"type":"integer","minimum":256,"maximum":8192},
            "height":{"type":"integer","minimum":256,"maximum":8192},
            "format":{"const":"png"}
          }
        },
        "protection_mode":{"enum":["none","pixel_exact"]},
        "regions":{
          "type":"array","maxItems":20,
          "items":{
            "type":"object","additionalProperties":false,
            "required":["source_x","source_y","width","height","target_x","target_y"],
            "properties":{
              "source_x":{"type":"integer","minimum":0},
              "source_y":{"type":"integer","minimum":0},
              "target_x":{"type":"integer","minimum":0},
              "target_y":{"type":"integer","minimum":0},
              "width":{"type":"integer","minimum":1,"maximum":8192},
              "height":{"type":"integer","minimum":1,"maximum":8192}
            }
          }
        }
      },
      "allOf":[
        {"if":{"properties":{"protection_mode":{"const":"none"}}},"then":{"properties":{"regions":{"maxItems":0}}}},
        {"if":{"properties":{"protection_mode":{"const":"pixel_exact"}}},"then":{"properties":{"regions":{"minItems":1}}}}
      ]
    },
    "targets":{
      "type":"array","minItems":1,"maxItems":3,"uniqueItems":true,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["platform","marketplace","category","image_type"],
        "properties":{
          "platform":{"enum":["amazon","temu","ozon"]},
          "marketplace":{"type":"string","minLength":1,"maxLength":32},
          "category":{"type":"string","minLength":1,"maxLength":100},
          "image_type":{"type":"string","minLength":1,"maxLength":32}
        }
      }
    }
  }
}
