{
  "kind": "concrete",
  "template_id": "core_image_resize_v2",
  "task": "image_resize",
  "profiles": ["stable", "low_vram"],
  "verified": true,
  "nodes": [
    {
      "key": "source",
      "class_type": "LoadImage",
      "title": "读取原图",
      "stage": "input",
      "group_title": "01 输入",
      "position": [80, 120],
      "inputs": {"image": "${source_image}"}
    },
    {
      "key": "resize",
      "class_type": "ImageScale",
      "title": "调整图片尺寸",
      "stage": "preprocessing",
      "group_title": "02 尺寸调整",
      "position": [380, 120],
      "inputs": {
        "image": {"link": ["source", 0]},
        "upscale_method": "lanczos",
        "width": "${width}",
        "height": "${height}",
        "crop": "disabled"
      }
    },
    {
      "key": "save",
      "class_type": "SaveImage",
      "title": "保存结果",
      "stage": "output",
      "group_title": "03 输出",
      "position": [700, 120],
      "inputs": {
        "images": {"link": ["resize", 0]},
        "filename_prefix": "${filename_prefix}"
      }
    }
  ]
}
