{
  "kind": "concrete",
  "template_id": "core_text_to_image_low_vram_v2",
  "task": "text_to_image",
  "profiles": ["low_vram"],
  "verified": true,
  "model_bindings": [
    {"binding": "checkpoint", "class_type": "CheckpointLoaderSimple", "input": "ckpt_name", "label": "基础模型"}
  ],
  "nodes": [
    {
      "key": "checkpoint",
      "class_type": "CheckpointLoaderSimple",
      "title": "加载基础模型",
      "stage": "model",
      "group_title": "01 模型",
      "position": [60, 260],
      "inputs": {"ckpt_name": "${checkpoint}"}
    },
    {
      "key": "positive",
      "class_type": "CLIPTextEncode",
      "title": "正向提示词",
      "stage": "conditioning",
      "group_title": "02 提示词",
      "position": [390, 80],
      "inputs": {"text": "${positive_prompt}", "clip": {"link": ["checkpoint", 1]}}
    },
    {
      "key": "negative",
      "class_type": "CLIPTextEncode",
      "title": "负向提示词",
      "stage": "conditioning",
      "group_title": "02 提示词",
      "position": [390, 390],
      "inputs": {"text": "${negative_prompt}", "clip": {"link": ["checkpoint", 1]}}
    },
    {
      "key": "latent",
      "class_type": "EmptyLatentImage",
      "title": "单批次潜空间",
      "stage": "latent",
      "group_title": "03 低显存潜空间",
      "position": [390, 690],
      "inputs": {"width": "${width}", "height": "${height}", "batch_size": 1}
    },
    {
      "key": "sampler",
      "class_type": "KSampler",
      "title": "低显存采样",
      "stage": "sampling",
      "group_title": "04 采样",
      "position": [760, 250],
      "inputs": {
        "model": {"link": ["checkpoint", 0]},
        "seed": "${seed}",
        "steps": "${steps}",
        "cfg": "${cfg}",
        "sampler_name": "${sampler_name}",
        "scheduler": "${scheduler}",
        "positive": {"link": ["positive", 0]},
        "negative": {"link": ["negative", 0]},
        "latent_image": {"link": ["latent", 0]},
        "denoise": "${denoise}"
      }
    },
    {
      "key": "decode",
      "class_type": "VAEDecodeTiled",
      "title": "分块 VAE 解码",
      "stage": "decode",
      "group_title": "05 低显存解码",
      "position": [1110, 250],
      "inputs": {
        "samples": {"link": ["sampler", 0]},
        "vae": {"link": ["checkpoint", 2]},
        "tile_size": 512,
        "overlap": 64,
        "temporal_size": 64,
        "temporal_overlap": 8
      }
    },
    {
      "key": "save",
      "class_type": "SaveImage",
      "title": "保存结果",
      "stage": "output",
      "group_title": "06 输出",
      "position": [1420, 250],
      "inputs": {"images": {"link": ["decode", 0]}, "filename_prefix": "${filename_prefix}"}
    }
  ]
}
